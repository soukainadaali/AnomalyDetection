    "# ============================================================\n",
    "# TUNE RANDOM FOREST — memory-safe version\n",
    "# ============================================================\n",
    "rf_param_grid = {\n",
    "    'n_estimators':      [100, 200],\n",
    "    'max_depth':         [10, 20, None],\n",
    "    'min_samples_split': [2, 5, 10],\n",
    "    'min_samples_leaf':  [1, 2, 4],\n",
    "    'max_features':      ['sqrt', 'log2'],\n",
    "}\n",
    "\n",
    "rf_search = RandomizedSearchCV(\n",
    "    RandomForestClassifier(class_weight='balanced', random_state=42, n_jobs=2),\n",
    "    param_distributions=rf_param_grid,\n",
    "    n_iter=10,          # reduced from 20\n",
    "    scoring='f1_macro',\n",
    "    cv=3,\n",
    "    random_state=42,\n",
    "    n_jobs=1,           # no parallelism at search level\n",
    "    verbose=1\n",
    ")\n",
    "rf_search.fit(X_train, y_train)\n",
    "\n",
    "print(f\"\\nBest RF params : {rf_search.best_params_}\")\n",
    "print(f\"Best RF CV F1  : {rf_search.best_score_:.4f}\")\n",
    "\n",
    "rf_best = rf_search.best_estimator_\n",
    "rf_val_f1   = f1_score(y_val,   rf_best.predict(X_val),   average='macro')\n",
    "rf_train_f1 = f1_score(y_train, rf_best.predict(X_train), average='macro')\n",
    "print(f\"Tuned RF train F1 : {rf_train_f1:.4f}\")\n",
    "print(f\"Tuned RF val F1   : {rf_val_f1:.4f}\")\n",
    "\n",
    "# ============================================================\n",
    "# TUNE XGBOOST — memory-safe version\n",
    "# ============================================================\n",
    "xgb_param_grid = {\n",

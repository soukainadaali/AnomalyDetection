   "source": [
    "# ============================================================\n",
    "# OVERFITTING CHECK — train vs val performance\n",
    "# ============================================================\n",
    "print(\"Overfitting check (train vs val accuracy):\\n\")\n",
    "for name, res in results.items():\n",
    "    y_pred_train = res['model'].predict(X_train)\n",
    "    train_acc = accuracy_score(y_train, y_pred_train)\n",
    "    val_acc   = res['acc']\n",
    "    gap       = train_acc - val_acc\n",
    "    flag      = ' ⚠ OVERFIT' if gap > 0.05 else ' ✓ OK'\n",
    "    print(f\"  {name:22} train={train_acc:.4f}  val={val_acc:.4f}  \"\n",
    "          f\"gap={gap:.4f}{flag}\")\n",
    "\n",
    "# ============================================================\n",
    "# SAVE ALL THREE MODELS\n",
    "# ============================================================\n",
    "import os\n",
    "os.makedirs('../models', exist_ok=True)\n",
    "\n",
    "for name, res in results.items():\n",
    "    filename = name.lower().replace(' ', '_')\n",
    "    joblib.dump(res['model'], f'../models/{filename}_baseline.pkl')\n",
    "    print(f\"Saved: ../models/{filename}_baseline.pkl\")"
   ]
  },

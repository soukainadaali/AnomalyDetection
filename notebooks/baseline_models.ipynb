    "    scoring='f1_macro',\n",
    "    cv=3,\n",
    "    random_state=42,\n",
    "    n_jobs=1,           # no parallelism at search level\n",
    "    verbose=1\n",
    ")\n",
    "xgb_search.fit(X_train, y_train)\n",
    "\n",
    "print(f\"\\nBest XGB params : {xgb_search.best_params_}\")\n",
    "print(f\"Best XGB CV F1  : {xgb_search.best_score_:.4f}\")\n",

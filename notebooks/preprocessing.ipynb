   "source": [
    "# Drop constant column that slipped through\n",
    "X = X.drop(columns=['wx_obs_tmzn'])\n",
    "print(f\"Dropped wx_obs_tmzn (constant). Features: {X.shape[1]}\")\n",
    "\n",
    "# Bool → cast to int (sklearn can't handle bool natively)\n",
    "bool_cols = X.select_dtypes(include='bool').columns.tolist()\n",
    "\n",
    "# Numeric = float + int (all go to StandardScaler)\n",
    "numeric_cols = (X.select_dtypes(include=['float64', 'int64'])\n",
    "                 .columns.tolist())\n",
    "\n",
    "# Categorical: LOW cardinality (≤50 unique) → OneHotEncoder\n",
    "ohe_cols = [\n",
    "    'acft_category', 'acft_expl', 'acft_fire', 'afm_hrs_since',\n",
    "    'air_medical', 'available_restraint', 'crew_category',\n",
    "    'crew_inj_level', 'crew_sex', 'crew_tox_perf', 'damage',\n",
    "    'dprt_pt_same_ev', 'elt_aided_loc_ev', 'elt_install',\n",
    "    'elt_oper', 'elt_type', 'ev_country', 'ev_dow', 'ev_nr_apt_loc',\n",
    "    'ev_season', 'ev_type', 'far_part', 'fixed_retractable',\n",
    "    'flight_plan_activated', 'flt_plan_filed', 'gust_ind',\n",
    "    'homebuilt', 'infl_rest_inst', 'latlong_acq', 'light_cond',\n",
    "    'med_certf', 'med_crtf_vldty', 'oper_individual_name',\n",
    "    'pc_profession', 'restraint_used', 'seat_occ_pic',\n",
    "    'second_pilot', 'site_seeing', 'sky_cond_ceil', 'sky_cond_nonceil',\n",
    "    'type_fly', 'type_last_insp', 'wind_dir_ind', 'wind_vel_ind',\n",
    "    'wx_cond_basic', 'wx_src_iic',\n",
    "]\n",
    "\n",
    "# Categorical: HIGH cardinality → Top-N grouping then OrdinalEncoder\n",
    "# We keep top N most frequent values, bin the rest as 'OTHER'\n",
    "high_card_cols = {\n",
    "    'acft_make':        20,   # Cessna, Piper, Beechcraft... top 20 covers ~85%\n",
    "    'acft_model':       30,   # more variation, need more buckets\n",
    "    'acft_series':      20,\n",
    "    'elt_manufacturer': 15,\n",
    "    'elt_model':        15,\n",
    "    'ev_state':         57,   # only 57 unique, keep all — it's US states\n",
    "    'med_crtf_limit':   20,\n",
    "    'rwy_num':          20,   # runway identifiers\n",
    "    # DROP these — city names / airport IDs with thousands of values,\n",
    "    # no generalizable signal for ML\n",
    "    # ev_city, ev_nr_apt_id, owner_acft → drop\n",
    "}\n",
    "\n",
    "drop_high_card = ['ev_city', 'ev_nr_apt_id', 'owner_acft']\n",
    "X = X.drop(columns=drop_high_card)\n",
    "print(f\"Dropped {len(drop_high_card)} ungroupable high-cardinality cols.\")\n",
    "print(f\"Features remaining: {X.shape[1]}\")\n",
    "\n",
    "# Apply Top-N grouping to high cardinality cols\n",
    "for col, top_n in high_card_cols.items():\n",
    "    if col in X.columns:\n",
    "        top_values = X[col].value_counts().nlargest(top_n).index\n",
    "        X[col] = X[col].where(X[col].isin(top_values), other='OTHER')\n",
    "        print(f\"  {col:25} → kept top {top_n}, rest → 'OTHER'  \"\n",
    "              f\"(now {X[col].nunique()} unique)\")\n",
    "\n",
    "print(f\"\\nFinal feature count before encoding: {X.shape[1]}\")\n",
    "print(f\"\\nEncoding summary:\")\n",
    "print(f\"  Numeric (StandardScaler)  : {len(numeric_cols)} cols\")\n",
    "print(f\"  Bool (cast to int)        : {len(bool_cols)} cols\")\n",
    "print(f\"  OHE (OneHotEncoder)       : {len(ohe_cols)} cols\")\n",
    "print(f\"  High-card (OrdinalEncoder): {len(high_card_cols)} cols\")"
   ]

   "source": [
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder, OrdinalEncoder\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.model_selection import train_test_split\n",
    "import joblib\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "#ENCODE TARGET\n",
    "le = LabelEncoder()\n",
    "y_encoded = le.fit_transform(y)\n",
    "print(f\"Target classes: {le.classes_}\")\n",
    "print(f\"Encoded as    : {list(range(len(le.classes_)))}\")\n",
    "\n",
    "#CAST BOOL COLUMNS TO INT\n",
    "for col in bool_cols:\n",
    "    if col in X.columns:\n",
    "        X[col] = X[col].astype(int)\n",
    "\n",
    "# Move bool cols into numeric for scaling\n",
    "numeric_all = numeric_cols + bool_cols\n",
    "\n",
    "# Final check — make sure no column is double-assigned\n",
    "all_assigned = set(numeric_all) | set(ohe_cols) | set(high_card_cols.keys())\n",
    "unassigned = [c for c in X.columns if c not in all_assigned]\n",
    "print(f\"\\nUnassigned columns: {unassigned}\")\n",
    "\n",
    "#TRAIN / VAL / TEST SPLIT (70 / 15 / 15)\n",
    "# Split BEFORE fitting anything — critical to prevent leakage\n",
    "X_temp, X_test, y_temp, y_test = train_test_split(\n",
    "    X, y_encoded,\n",
    "    test_size=0.15,\n",
    "    random_state=42,\n",
    "    stratify=y_encoded\n",
    ")\n",
    "X_train, X_val, y_train, y_val = train_test_split(\n",
    "    X_temp, y_temp,\n",
    "    test_size=0.1765,   # 0.1765 of 85% ≈ 15% of total\n",
    "    random_state=42,\n",
    "    stratify=y_temp\n",
    ")\n",
    "\n",
    "print(f\"\\nSplit sizes:\")\n",
    "print(f\"  Train : {X_train.shape[0]:,} rows ({X_train.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"  Val   : {X_val.shape[0]:,} rows ({X_val.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"  Test  : {X_test.shape[0]:,} rows ({X_test.shape[0]/len(X)*100:.1f}%)\")\n",
    "\n",
    "# Verify stratification held\n",
    "print(f\"\\nClass balance in splits:\")\n",
    "for name, y_s in [('train', y_train), ('val', y_val), ('test', y_test)]:\n",
    "    counts = pd.Series(y_s).value_counts(normalize=True).sort_index()\n",
    "    print(f\"  {name}: {[f'{le.classes_[i]}={v:.2f}' for i,v in counts.items()]}\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 6: BUILD COLUMNTRANSFORMER PIPELINE\n",
    "# ==============\n",
    "# Get final lists (only cols that exist in X after all drops)\n",
    "numeric_final  = [c for c in numeric_all      if c in X.columns]\n",
    "ohe_final      = [c for c in ohe_cols         if c in X.columns]\n",
    "ordinal_final  = [c for c in high_card_cols   if c in X.columns]\n",
    "\n",
    "preprocessor = ColumnTransformer(transformers=[\n",
    "    ('num',     StandardScaler(),\n",
    "                numeric_final),\n",
    "    ('ohe',     OneHotEncoder(handle_unknown='ignore', sparse_output=False),\n",
    "                ohe_final),\n",
    "    ('ordinal', OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1),\n",
    "                ordinal_final),\n",
    "], remainder='drop')\n",
    "\n",
    "# ============================================================\n",
    "# STEP 7: FIT ON TRAIN ONLY, TRANSFORM ALL SPLITS\n",
    "# ============================================================\n",
    "X_train_proc = preprocessor.fit_transform(X_train)\n",
    "X_val_proc   = preprocessor.transform(X_val)\n",
    "X_test_proc  = preprocessor.transform(X_test)\n",
    "\n",
    "print(f\"\\nProcessed shapes:\")\n",
    "print(f\"  X_train : {X_train_proc.shape}\")\n",
    "print(f\"  X_val   : {X_val_proc.shape}\")\n",
    "print(f\"  X_test  : {X_test_proc.shape}\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 8: SAVE EVERYTHING\n",
    "# ============================================================\n",
    "import os\n",
    "os.makedirs('../data/processed', exist_ok=True)\n",
    "os.makedirs('../models', exist_ok=True)\n",
    "\n",
    "joblib.dump(preprocessor, '../models/preprocessing_pipeline.pkl')\n",
    "joblib.dump(le,           '../models/label_encoder.pkl')\n",
    "\n",
    "# Save processed arrays for direct use\n",
    "np.save('../data/processed/X_train.npy', X_train_proc)\n",
    "np.save('../data/processed/X_val.npy',   X_val_proc)\n",
    "np.save('../data/processed